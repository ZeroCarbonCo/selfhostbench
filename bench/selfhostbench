# ---------------------------------------------------------------- terminal output

TTY = sys.stdout.isatty()
COLOR = TTY and not os.environ.get("NO_COLOR") and os.environ.get("TERM", "") != "dumb"
UTF8 = (sys.stdout.encoding or "").lower().replace("-", "") == "utf8"
