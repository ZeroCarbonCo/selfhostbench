def ffmpeg_progress(output):
    """Parse the last block of `ffmpeg -progress pipe:1`; ffmpeg itself reports fps and speed."""
    block = {}
    for line in output.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            block[k.strip()] = v.strip()
    if block.get("progress") != "end":
        return None
    try:
        return {"frames": int(block["frame"]), "fps": float(block["fps"]),
                "speed": float(block["speed"].rstrip("x"))}
    except (KeyError, ValueError):
        return None


def transcode_cmd(name, method, seconds=None):
    cmd = ["docker", "exec", name, FFMPEG, "-hide_banner", "-nostats", "-loglevel", "error", "-progress", "pipe:1"]
    if method == "vaapi":
        cmd += ["-init_hw_device", "vaapi=va:/dev/dri/renderD128", "-hwaccel", "vaapi",
                "-hwaccel_output_format", "vaapi"]
    elif method == "nvenc":
        cmd += ["-hwaccel", "cuda", "-hwaccel_output_format", "cuda"]
    if seconds:
        cmd += ["-t", str(seconds)]
    cmd += ["-i", "/media/clip.mkv", "-an", "-sn"]
    if method == "vaapi":
        cmd += ["-vf", f"scale_vaapi=w={SCALE_W}:h={SCALE_H}:format=nv12", "-c:v", "h264_vaapi", "-b:v", "8M",
                "-maxrate", "8M"]
    elif method == "nvenc":
        cmd += ["-vf", f"scale_cuda={SCALE_W}:{SCALE_H}", "-c:v", "h264_nvenc", "-preset", "p4", "-b:v", "8M",
                "-maxrate", "8M"]
    else:
        cmd += ["-vf", f"scale={SCALE_W}:{SCALE_H}", *X264]
    return cmd + ["-f", "null", "-"]


def run_streams(name, method, n, seconds, timeout, st=None):
    """Run n transcodes at once; returns ffmpeg's final stats for each, or None if any failed or timed out."""
    procs = [subprocess.Popen(transcode_cmd(name, method, seconds), stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, text=True) for _ in range(n)]
    state = [{"t": 0.0, "speed": "", "lines": []} for _ in procs]

    def reader(i, p):
        for line in p.stdout:
            state[i]["lines"].append(line)
            k, _, v = line.strip().partition("=")
            if k == "out_time_us" and v.lstrip("-").isdigit():
                state[i]["t"] = max(0, int(v)) / 1e6
            elif k == "speed":
                state[i]["speed"] = v

    threads = [threading.Thread(target=reader, args=(i, p), daemon=True) for i, p in enumerate(procs)]
    for t in threads:
        t.start()
    target = seconds or CLIP_SECONDS
    deadline = time.monotonic() + timeout
    while any(p.poll() is None for p in procs) and time.monotonic() < deadline:
        if st:
            slowest = min(state, key=lambda s: s["t"])
            speed = slowest["speed"] if slowest["speed"] not in ("", "N/A") else "…"
            st.update(min(1.0, slowest["t"] / target), f"speed {speed}"
                      + (" (slowest stream)" if n > 1 else ""))
        time.sleep(0.25)
    timed_out = any(p.poll() is None for p in procs)
    for t in threads:
        t.join(timeout=5)
    if timed_out:
        for p in procs:
            p.kill()
        docker("restart", "-t", "0", name, check=False)  # kills leftover ffmpeg processes inside the container
        return None
    results = [ffmpeg_progress("".join(s["lines"])) for s in state]
    return None if any(r is None for r in results) else results


def test_jellyfin(hw, use_gpu):
    image = IMAGES["jellyfin"]
    ensure_image("jellyfin")
    clip = fetch_media("clip")
    base_args = ["--entrypoint", "/bin/sleep", "-v", f"{clip}:/media/clip.mkv:ro"]
    hw_method, hw_args = None, []
    if use_gpu and hw["dri_render_nodes"] and Path("/dev/dri/renderD128").exists():
        hw_method = "vaapi"
        hw_args = ["--device", "/dev/dri:/dev/dri", "--group-add", str(os.stat("/dev/dri/renderD128").st_gid)]
    elif use_gpu and hw["nvidia"]:
        hw_method = "nvenc"
        hw_args = ["--gpus", "all", "-e", "NVIDIA_DRIVER_CAPABILITIES=compute,video,utility"]
    with Status("Starting Jellyfin"):
        try:
            name = start_container("jellyfin", image, base_args + hw_args, ["infinity"])
        except RuntimeError:
            if not hw_method:
                raise
            warn(f"could not pass the GPU through ({hw_method}); testing the CPU only")
            hw_method = None
            name = start_container("jellyfin-cpu", image, base_args, ["infinity"])
    digest = image_digest(image)
    out = []

    def record(test, accel, metrics, res, status="ok", reason=None):
        out.append({"app": "jellyfin", "test": test, "accel": accel, "image": image.split("@")[0],
                    "image_digest": digest, "status": status, "reason": reason, "metrics": metrics,
                    "resources": res})

    for method in ["software"] + ([hw_method] if hw_method else []):
        accel = "cpu" if method == "software" else method
        label = "CPU" if method == "software" else {"vaapi": "VA-API GPU", "nvenc": "NVIDIA NVENC"}[method]
        # Short warm-up so one-off start-up costs (e.g. GPU driver JIT) don't count against the result.
        with Status(f"Warming up ({label})"):
            ok = run_streams(name, method, 1, 2, timeout=900)
        if not ok:
            record("transcode_4k_1080p", accel, {}, {}, "failed", f"{method} warm-up did not complete")
            warn(f"{label} transcoding failed; skipping it")
            continue
        with Status(f"Converting 4K video to 1080p ({label})") as st, Sampler(name) as s:
            r = run_streams(name, method, 1, None, timeout=1800, st=st)
        if not r:
            record("transcode_4k_1080p", accel, {}, s.result, "failed", f"{method} transcode did not complete")
            warn(f"{label} transcoding failed")
            continue
        r = r[0]
        result_line(f"{r['fps']:.1f} fps, {r['speed']:.2f}x real time")
        record("transcode_4k_1080p", accel, {"fps": r["fps"], "speed": r["speed"]}, s.result)
        if r["speed"] < 1.0:
            # Can't keep up with even one stream, so there's nothing to step up.
            record("concurrent_streams", accel, {"streams": 0, "cap": CONCURRENCY_CAP}, s.result)
            note("Below real time, so simultaneous streams = 0 (skipped the step-up test)")
            continue
        best = 0
        with Status(f"Simultaneous streams at >= 1x real time ({label})") as st, Sampler(name) as s:
            for n in range(1, CONCURRENCY_CAP + 1):
                st.label = f"Simultaneous streams ({label}): trying {n}"
                res = run_streams(name, method, n, CONCURRENCY_SECONDS, timeout=CONCURRENCY_SECONDS * 6, st=st)
                slowest = min(x["speed"] for x in res) if res else 0
                if slowest < 1.0:
                    break
                best = n
            st.label = f"Simultaneous streams at >= 1x real time ({label})"
        result_line(f"{best}{'+' if best >= CONCURRENCY_CAP else ''} stream(s) at once")
        record("concurrent_streams", accel, {"streams": best, "cap": CONCURRENCY_CAP}, s.result)
    return out


