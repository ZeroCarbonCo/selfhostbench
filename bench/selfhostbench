def test_ollama(hw, use_gpu):
    image = IMAGES["ollama"]
    ensure_image("ollama")
    vol = make_volume("ollama")
    args = ["-p", "127.0.0.1::11434", "-v", f"{vol}:/root/.ollama"]
    name, accel = None, "cpu"
    with Status("Starting Ollama"):
        if use_gpu and hw["nvidia"]:
            try:
                name = start_container("ollama-gpu", image, ["--gpus", "all", *args])
                accel = "nvidia"
            except RuntimeError as e:
                warn(f"NVIDIA GPU not available to Docker, using CPU ({str(e)[-100:]})")
        if not name:
            name = start_container("ollama", image, args)
        base = f"http://127.0.0.1:{host_port(name, 11434)}"
        wait_http(f"{base}/api/version")
    with Status(f"Downloading AI model {OLLAMA_MODEL}") as st:
        req = urllib.request.Request(f"{base}/api/pull", data=json.dumps({"model": OLLAMA_MODEL}).encode(),
                                     headers={"Content-Type": "application/json"})
        parts = {}
        with urllib.request.urlopen(req, timeout=3600) as r:
            for line in r:
                d = json.loads(line)
                if "error" in d:
                    raise RuntimeError(f"model download failed: {d['error']}")
                if d.get("digest") and d.get("total"):
                    parts[d["digest"]] = (d.get("completed") or 0, d["total"])
                    done, total = sum(c for c, _ in parts.values()), sum(t for _, t in parts.values())
                    st.update(done / total, f"{fmt_bytes(done)} of {fmt_bytes(total)}")
                elif d.get("status"):
                    st.update(st.frac, d["status"][:30])
    digest = next((m.get("digest", "") for m in http_json(f"{base}/api/tags")["models"]
                   if m.get("name") == OLLAMA_MODEL), "")
    gen = {"model": OLLAMA_MODEL, "prompt": OLLAMA_PROMPT, "stream": False, "options": OLLAMA_OPTIONS}
    with Status("Loading the model (warm-up, not timed)"):
        http_json(f"{base}/api/generate", dict(gen, options=dict(OLLAMA_OPTIONS, num_predict=8)), timeout=1800)
        ps = http_json(f"{base}/api/ps").get("models", [{}])
    size, vram = (ps[0].get("size") or 0, ps[0].get("size_vram") or 0) if ps else (0, 0)
    offload = round(100 * vram / size) if size else 0
    if accel == "nvidia" and offload == 0:
        accel = "cpu"  # container had the GPU but the model ran on CPU
    tps, ptps = [], []
    where = f"NVIDIA GPU, {offload}% of model in VRAM" if accel == "nvidia" else "CPU"
    with Status(f"Generating text, {OLLAMA_RUNS} runs ({where})") as st, Sampler(name) as s:
        for i in range(OLLAMA_RUNS):
            st.update(i / OLLAMA_RUNS, f"run {i + 1} of {OLLAMA_RUNS}"
                      + (f"  last: {tps[-1]:.1f} tokens/s" if tps else ""))
            r = http_json(f"{base}/api/generate", gen, timeout=1800)
            tps.append(r["eval_count"] / r["eval_duration"] * 1e9)
            if r.get("prompt_eval_duration"):
                ptps.append(r["prompt_eval_count"] / r["prompt_eval_duration"] * 1e9)
    result_line(f"{statistics.median(tps):.1f} tokens/s  " + dim(f"(runs: {', '.join(f'{x:.1f}' for x in tps)})"))
    return [{
        "app": "ollama", "test": "generate", "accel": accel, "image": image.split("@")[0],
        "image_digest": image_digest(image), "status": "ok",
        "metrics": {"tokens_per_s": round(statistics.median(tps), 2),
                    "prompt_tokens_per_s": round(statistics.median(ptps), 1) if ptps else None,
                    "runs_tokens_per_s": [round(x, 2) for x in tps], "gpu_offload_pct": offload,
                    "model": OLLAMA_MODEL, "model_digest": digest[:71]},
        "resources": s.result,
    }]


