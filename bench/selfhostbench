def verdict(t):
    m = t["metrics"]
    if t["test"] == "generate":
        v = m["tokens_per_s"]
        return ("fast: replies appear instantly" if v >= 30 else "comfortable for chat" if v >= 10
                else "usable but slow" if v >= 4 else "too slow for comfortable chat")
    if t["test"] == "transcode_4k_1080p":
        return ("keeps up with a 4K stream" if m["speed"] >= 1 else "too slow for live 4K: use direct play")
    if t["test"] == "concurrent_streams":
        n = m["streams"]
        return ("can't sustain one 4K->1080p stream" if n == 0
                else f"{n}+ people streaming at once (test stops at {m['cap']})" if n >= m["cap"]
                else f"{n} {'person' if n == 1 else 'people'} streaming at once")
    hours = 10000 / m["images_per_s"] / 3600 if m["images_per_s"] else 0
    return f"about {hours * 60:.0f} min per 10,000 photos" if hours < 1.5 else f"about {hours:.1f} h per 10,000 photos"


VIRT_NAMES = {"wsl": "WSL2", "kvm": "a KVM virtual machine", "docker": "a container", "lxc": "an LXC container"}


def summary(doc):
    labels = {"generate": "chat speed", "transcode_4k_1080p": "4K -> 1080p",
              "concurrent_streams": "simultaneous streams", "clip_embeddings": "smart search",
              "face_detection": "face detection"}
    accels = {"cpu": "CPU", "nvidia": "GPU", "nvenc": "NVENC", "vaapi": "VA-API", "qsv": "QSV", "none": ""}
    heading(f"Results for {doc['hardware']['device_label']}")
    rows = []
    for t in doc["tests"]:
        m = t["metrics"]
        name = f"{t['app'].capitalize()} {labels.get(t['test'], t['test'])}" + (f" ({accels.get(t['accel'], t['accel'])})" if t["accel"] != "none" else "")
        if t["status"] != "ok":
            rows.append((name, red(t["status"]), (t.get("reason") or "")[:60]))
            continue
        val = (f"{m['tokens_per_s']:.1f} tokens/s" if "tokens_per_s" in m else f"{m['fps']:.1f} fps" if "fps" in m
               else f"{m['streams']}{'+' if m['streams'] >= m['cap'] else ''} streams" if "streams" in m
               else f"{m['images_per_s']:.2f} photos/s")
        rows.append((name, val, verdict(t)))
    w0 = max(len(r[0]) for r in rows) + 2
    w1 = max(len(re.sub(r"\x1b\[[0-9;]*m", "", r[1])) for r in rows) + 2
    for a, b, c in rows:
        pad = w1 - len(re.sub(r"\x1b\[[0-9;]*m", "", b))
        say(f"  {a:<{w0}}{bold(b)}{' ' * pad}{dim(c)}")
    if doc["hardware"]["virtualization"] != "none":
        note(f"Ran inside {VIRT_NAMES.get(doc['hardware']['virtualization'], 'a VM')}: bare-metal numbers may be higher.")


# ---------------------------------------------------------------- submission

def submit(doc, api=API_BASE):
    body = json.dumps(doc).encode()
    headers = {"Content-Type": "application/json", "User-Agent": f"selfhostbench/{VERSION}"}
    if os.environ.get("SELFHOSTBENCH_OWNER_TOKEN"):  # maintainer's own test runs, excluded from counts
        headers["X-SHB-Owner"] = os.environ["SELFHOSTBENCH_OWNER_TOKEN"]
    for attempt in (1, 2):
        try:
            req = urllib.request.Request(f"{api}/api/submit", data=body, method="POST", headers=headers)
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            msg = e.read().decode(errors="replace")[:300]
            if e.code < 500:
                raise RuntimeError(f"server rejected the result ({e.code}): {msg}")
            err = f"{e.code} {msg}"
        except (urllib.error.URLError, OSError) as e:
            err = str(e)
        if attempt == 1:
            warn(f"submission failed ({err}); retrying in 5 s")
            time.sleep(5)
    raise RuntimeError(err)


def offer_submit(doc, path, api, confirmed=False):
    heading("Share your results?")
    say("  Here is exactly what would be sent. Nothing else is collected: no hostname, IP, serials or paths.\n")
    say(json.dumps(doc, indent=2))
    say("")
    if not confirmed and not ask(f"Submit these results to {api.split('//')[-1]}? They will be public.", default=False):
        note(f"Not submitted. To submit later: python3 {sys.argv[0]} submit {path}")
        return
    try:
        r = submit(doc, api)
        say(f"  {green(TICK)} Submitted, thank you!")
        say(f"    Your result:        {bold(r.get('url', ''))}")
        if r.get("device_url"):
            say(f"    Your device's page: {r['device_url']}")
            note("Sign up on that page to hear when more people with this device submit.")
    except RuntimeError as e:
        warn(f"Could not submit ({e}).")
        note(f"Your results are saved in {path}")
        note(f"To try again later: python3 {sys.argv[0]} submit {path}")


