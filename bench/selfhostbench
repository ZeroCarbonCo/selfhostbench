BAR_FULL, BAR_EMPTY = ("█", "░") if UTF8 else ("#", "-")
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏" if UTF8 else "|/-\\"
OUT_LOCK = threading.Lock()


def paint(code, s):
    return f"\033[{code}m{s}\033[0m" if COLOR else str(s)


def bold(s):
    return paint("1", s)


def dim(s):
    return paint("2", s)


def green(s):
    return paint("32", s)


def yellow(s):
    return paint("33", s)


def red(s):
    return paint("31", s)


def say(msg=""):
    with OUT_LOCK:
        print(msg, flush=True)


def heading(msg):
    say(f"\n{bold(msg)}")


def note(msg):
    say(f"  {dim(msg)}")


def warn(msg):
    say(f"  {yellow('!')} {msg}")


def fmt_secs(s):
    s = int(s)
    return f"{s // 3600}h {s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m {s % 60:02d}s" if s >= 60 else f"{s}s"


def fmt_bytes(n):
    return f"{n / 1e9:.1f} GB" if n >= 1e9 else f"{n / 1e6:.0f} MB"


class Status:
    """A live status line (spinner, optional progress bar) that ends as a ✓ or ✗ line."""

    def __init__(self, label):
        self.label, self.frac, self.detail = label, None, ""
        self.t0 = time.monotonic()
        self.stop = threading.Event()
        self.plain_pct = -1

    def __enter__(self):
        if TTY:
            threading.Thread(target=self._tick, daemon=True).start()
        else:
            say(f"  ... {self.label}")
        return self

    def _tick(self):
        while not self.stop.wait(0.12):
            self._draw()

    def _draw(self):
        elapsed = time.monotonic() - self.t0
        spin = SPIN[int(elapsed * 10) % len(SPIN)]
        bar = ""
        if self.frac is not None:
            filled = int(24 * max(0.0, min(1.0, self.frac)))
            bar = f"{BAR_FULL * filled}{BAR_EMPTY * (24 - filled)} {int(100 * self.frac):3d}%  "
        line = f"  {spin} {self.label}  {bar}{self.detail}"
        width = shutil.get_terminal_size((80, 20)).columns - 8
        line = line[:width] + f"  {fmt_secs(elapsed)}"
        with OUT_LOCK:
            sys.stdout.write("\r\033[2K" + paint("36", line))
            sys.stdout.flush()

    def update(self, frac=None, detail=None):
        self.frac = frac
        if detail is not None:
            self.detail = detail
        if not TTY and frac is not None and int(frac * 4) > self.plain_pct:
            self.plain_pct = int(frac * 4)
            say(f"      {int(100 * frac)}% {self.detail}")

    def __exit__(self, exc_type, exc, tb):
        self.stop.set()
        with OUT_LOCK:
            if TTY:
                sys.stdout.write("\r\033[2K")
            mark = green(TICK) if exc_type is None else red(CROSS)
            print(f"  {mark} {self.label} {dim('(' + fmt_secs(time.monotonic() - self.t0) + ')')}", flush=True)
        return False


def result_line(msg):
    say(f"    {bold(msg)}")


def ask(question, default=False):
    if ASSUME_YES or not sys.stdin.isatty():
        return default
    suffix = " [Y/n] " if default else " [y/N] "
    try:
        ans = input(bold(question) + suffix).strip().lower()
    except EOFError:
        return default
    return default if not ans else ans in ("y", "yes")


# ---------------------------------------------------------------- small helpers

def run(cmd, check=True, timeout=None, capture=True):
    p = subprocess.run(cmd, capture_output=capture, text=True, timeout=timeout)
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd[:4])} … failed: {(p.stderr or p.stdout or '').strip()[-400:]}")
    return p


def docker(*args, **kw):
    return run(["docker", *args], **kw)


def read(path, default=""):
    try:
        return Path(path).read_text(errors="replace").strip()
    except OSError:
        return default


def http_json(url, payload=None, timeout=30):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json",
                                                          "User-Agent": f"selfhostbench/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def wait_http(url, seconds=120):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=3) as r:
                if r.status == 200:
                    return
        except (urllib.error.URLError, ConnectionError, OSError):
            pass
        time.sleep(1)
    raise RuntimeError(f"service at {url} did not start within {seconds}s")


def host_port(container, port):
    out = docker("port", container, f"{port}/tcp").stdout.strip().splitlines()[0]
    return int(out.rsplit(":", 1)[1])


# ---------------------------------------------------------------- hardware

GENERIC = {"", "to be filled by o.e.m.", "system product name", "default string", "system manufacturer",
           "not specified", "o.e.m.", "none", "unknown", "type1productconfigid", "all series"}


def short_cpu(name):
    s = re.sub(r"\((R|TM|tm|r)\)", "", name)
    s = re.sub(r"\bCPU\b|\bProcessor\b|@.*$|\d+-Core|with Radeon.*$|w/ Radeon.*$", "", s)
    return re.sub(r"\s+", " ", s).strip()


def detect_hardware():
    info = {}
    cpuinfo = read("/proc/cpuinfo")
    model = ""
    for key in ("model name", "Model", "Hardware"):
        m = re.search(rf"^{key}\s*:\s*(.+)$", cpuinfo, re.M)
        if m:
            model = m.group(1).strip()
            break
    if not model and shutil.which("lscpu"):
        m = re.search(r"^Model name:\s*(.+)$", run(["lscpu"], check=False).stdout, re.M)
        model = m.group(1).strip() if m else ""
    info["cpu_model"] = model or "unknown"
    info["cpu_short"] = short_cpu(info["cpu_model"])[:80]
    info["cpu_threads"] = os.cpu_count() or 0
    cores = set(re.findall(r"physical id\s*:\s*(\d+)[\s\S]*?core id\s*:\s*(\d+)", cpuinfo))
    info["cpu_cores"] = len(cores) or info["cpu_threads"]
    m = re.search(r"^MemTotal:\s*(\d+)", read("/proc/meminfo"), re.M)
    info["ram_gb"] = round(int(m.group(1)) / 1024 / 1024, 1) if m else 0
    vendor = read("/sys/class/dmi/id/sys_vendor")
    product = read("/sys/class/dmi/id/product_name")
    if not product:
        product = read("/proc/device-tree/model").rstrip("\x00")  # Raspberry Pi and other SBCs
    info["system_vendor"] = vendor[:60]
    info["system_model"] = product[:80]
    info["arch"] = platform.machine()
    os_rel = read("/etc/os-release")
    m = re.search(r'^PRETTY_NAME="?([^"\n]+)', os_rel, re.M)
    info["os"] = m.group(1) if m else platform.system()
    info["kernel"] = platform.release()[:80]
    virt = run(["systemd-detect-virt"], check=False).stdout.strip() if shutil.which("systemd-detect-virt") else ""
    if "microsoft" in platform.release().lower():
        virt = "wsl"
    info["virtualization"] = virt or "none"
    # GPUs: names only.
    gpus = []
    if shutil.which("lspci"):
        for line in run(["lspci", "-mm"], check=False).stdout.splitlines():
            parts = shlex.split(line)
            if len(parts) >= 4 and re.search(r"VGA|3D|Display", parts[1]):
                gpus.append(f"{parts[2]} {parts[3]}"[:100])
    nvsmi = shutil.which("nvidia-smi") or ("/usr/lib/wsl/lib/nvidia-smi" if os.path.exists("/usr/lib/wsl/lib/nvidia-smi") else None)
    nv_names = []
    if nvsmi:
        nv_names = [n.strip() for n in run([nvsmi, "--query-gpu=name", "--format=csv,noheader"], check=False).stdout.splitlines() if n.strip()]
        gpus += [n[:100] for n in nv_names if not any(n in g for g in gpus)]
    info["gpus"] = gpus[:4]
    info["nvidia"] = bool(nv_names)
    info["dri_render_nodes"] = len(list(Path("/dev/dri").glob("renderD*"))) if Path("/dev/dri").exists() else 0
    info["docker_version"] = docker("version", "--format", "{{.Server.Version}}", check=False).stdout.strip()[:30]
    info["docker_os"] = docker("info", "--format", "{{.OperatingSystem}}", check=False).stdout.strip()[:60]
    info["power_source"] = "rapl" if rapl_zone() else "not available"
    # A label for grouping results. Never includes serials, hostnames or user names.
    if info["virtualization"] == "wsl":
        label = f"WSL2 on {info['cpu_short']}"
    elif info["virtualization"] not in ("none", ""):
        label = f"VM ({info['virtualization']}) on {info['cpu_short']}"
    elif product.lower() in GENERIC:
        label = f"Custom PC with {info['cpu_short']}"
    elif vendor.lower() in GENERIC or product.lower().startswith(vendor.lower().split()[0]):
        label = product  # e.g. "Raspberry Pi 5 Model B Rev 1.0", or vendor already in the name
    else:
        label = f"{vendor} {product}"
    info["device_label"] = re.sub(r"\s+", " ", label).strip()[:100]
    return info


def rapl_zone():
    """Return a readable CPU package energy counter, or None (we never ask for root)."""
    base = Path("/sys/class/powercap")
    for zone in sorted(base.glob("*-rapl:*")) if base.exists() else []:
        if ":" in zone.name.split("rapl:")[1]:
            continue  # sub-zones (core, uncore, dram)
        try:
            if read(zone / "name").startswith("package"):
                int((zone / "energy_uj").read_text())
                return zone
        except (OSError, ValueError):
            continue
    return None


# ---------------------------------------------------------------- resource sampling

class Sampler:
    """Samples container CPU % / memory once per second via `docker stats`, and RAPL power if readable."""

    def __init__(self, container):
        self.container = container
        self.cpu, self.mem = [], []
        self.zone = rapl_zone()
        self.energy0 = self.t0 = None
        self.proc = None
        self.result = {}

    def _energy(self):
        try:
            return int((self.zone / "energy_uj").read_text())
        except (OSError, ValueError, TypeError):
            return None

    def __enter__(self):
        if self.zone:
            self.energy0, self.t0 = self._energy(), time.monotonic()
        self.proc = subprocess.Popen(["docker", "stats", "--format", "{{json .}}", self.container],
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        threading.Thread(target=self._read, daemon=True).start()
        return self

    def _read(self):
        for line in self.proc.stdout:
            line = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line).strip()
            if not line.startswith("{"):
                continue
            try:
                d = json.loads(line)
                self.cpu.append(float(d["CPUPerc"].rstrip("%")))
                self.mem.append(parse_size(d["MemUsage"].split("/")[0]))
            except (ValueError, KeyError):
                continue

    def __exit__(self, *exc):
        self.proc.terminate()
        try:
            self.proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        self.result = {
            "samples": len(self.cpu),
            "cpu_pct_peak": round(max(self.cpu), 1) if self.cpu else None,
            "cpu_pct_mean": round(statistics.mean(self.cpu), 1) if self.cpu else None,
            "mem_mb_peak": round(max(self.mem)) if self.mem else None,
            "power_w_mean": None,
        }
        if self.zone and self.energy0 is not None:
            e1, t1 = self._energy(), time.monotonic()
            if e1 is not None and t1 > self.t0:
                delta = e1 - self.energy0
                if delta < 0:
                    delta += int(read(self.zone / "max_energy_range_uj", "0") or 0)
                self.result["power_w_mean"] = round(delta / 1e6 / (t1 - self.t0), 1)
        return False


def parse_size(s):
    m = re.match(r"\s*([\d.]+)\s*([KMGT]?i?B)", s)
    if not m:
        return 0.0
    mult = {"B": 1 / 2**20, "KiB": 1 / 1024, "KB": 1 / 1024, "MiB": 1, "MB": 1, "GiB": 1024, "GB": 1024,
            "TiB": 2**20, "TB": 2**20}
    return float(m.group(1)) * mult.get(m.group(2), 1)


# ---------------------------------------------------------------- docker lifecycle

def start_container(name, image, args=(), cmd=()):
    full = f"shb-{name}-{RUN_ID}"
    try:
        docker("run", "-d", "--name", full, "--label", LABEL, *args, image, *cmd)
    finally:
        CREATED["containers"].append(full)  # remove even a half-created container
    return full


def make_volume(name):
    vol = f"shb-{name}-{RUN_ID}"
    docker("volume", "create", "--label", LABEL, vol)
    CREATED["volumes"].append(vol)
    return vol


def cleanup():
    if not CREATED["containers"] and not CREATED["volumes"]:
        return
    for c in CREATED["containers"]:
        docker("rm", "-f", "-v", c, check=False)
    for v in CREATED["volumes"]:
        docker("volume", "rm", "-f", v, check=False)
    CREATED["containers"].clear()
    CREATED["volumes"].clear()


def image_digest(image):
    out = docker("image", "inspect", "--format", "{{json .RepoDigests}}", image, check=False).stdout.strip()
    try:
        digests = json.loads(out) or []
    except ValueError:
        digests = []
    return digests[0].split("@", 1)[1] if digests else image.split("@", 1)[-1]


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.unix_path)


def docker_socket():
    host = os.environ.get("DOCKER_HOST") or docker(
        "context", "inspect", "--format", "{{.Endpoints.docker.Host}}", check=False).stdout.strip()
    path = host[len("unix://"):] if host.startswith("unix://") else ""
    return path if path and os.access(path, os.R_OK | os.W_OK) else None


def pull_via_api(image, st, expected):
    """Pull through the Docker Engine API so we can show byte-level progress."""
    sock = docker_socket()
    if not sock:
        return False
    ref, digest = image.split("@")
    repo = ref.rsplit(":", 1)[0] if ":" in ref.rsplit("/", 1)[-1] else ref
    conn = UnixHTTPConnection(sock, timeout=3600)
    conn.request("POST", "/images/create?" + urllib.parse.urlencode({"fromImage": repo, "tag": digest}))
    r = conn.getresponse()
    if r.status != 200:
        return False
    layers = {}
    while True:
        line = r.readline()
        if not line:
            break
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if "error" in d:
            raise RuntimeError(f"pull failed: {d['error']}")
        lid, status, pd = d.get("id"), d.get("status", ""), d.get("progressDetail") or {}
        if status == "Downloading" and pd.get("total"):
            layers[lid] = [pd.get("current", 0), pd["total"]]
        elif status in ("Download complete", "Pull complete") and lid in layers:
            layers[lid][0] = layers[lid][1]
        # Docker only reports sizes for layers in flight, so measure progress against the known image size.
        done = sum(c for c, _ in layers.values())
        if status == "Extracting":
            st.update(None, f"unpacking … ({fmt_bytes(done)} downloaded)")
        elif done:
            st.update(min(0.99, done / expected), f"{fmt_bytes(done)} of ~{fmt_bytes(expected)}")
    conn.close()
    return docker("image", "inspect", image, check=False).returncode == 0


def ensure_image(app):
    image = IMAGES[app]
    if docker("image", "inspect", image, check=False).returncode == 0:
        return
    expected = IMAGE_MB[app][platform.machine() in ("aarch64", "arm64")] * 1e6
    with Status(f"Downloading {image.split('@')[0]}") as st:
        try:
            ok = pull_via_api(image, st, expected)
        except (OSError, http.client.HTTPException):
            ok = False
        if not ok:
            st.update(None, "(docker pull)")
            run(["docker", "pull", "-q", image], timeout=3600)


# ---------------------------------------------------------------- media

def fetch_media(key):
    meta = MEDIA[key]
    cache = HOME / "cache"
    cache.mkdir(parents=True, exist_ok=True)
    dest = cache / meta["file"]
    if dest.exists() and sha256(dest) == meta["sha256"]:
        return dest
    with Status(f"Downloading test media {meta['file']}") as st:
        tmp = dest.with_suffix(".part")
        req = urllib.request.Request(f"{RELEASE}/{meta['file']}", headers={"User-Agent": f"selfhostbench/{VERSION}"})
        with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
            total = int(r.headers.get("Content-Length") or meta["mb"] * 1e6)
            done = 0
            for chunk in iter(lambda: r.read(1 << 20), b""):
                f.write(chunk)
                done += len(chunk)
                st.update(done / total, f"{fmt_bytes(done)} of {fmt_bytes(total)}")
        if sha256(tmp) != meta["sha256"]:
            tmp.unlink()
            raise RuntimeError(f"{meta['file']} failed its SHA-256 check")
        tmp.rename(dest)
    return dest


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


