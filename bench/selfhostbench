def preflight(apps, hw):
    if not shutil.which("docker"):
        sys.exit("Docker is required but the `docker` command was not found. Install Docker, then run again.")
    p = docker("info", "--format", "{{.ServerVersion}}", check=False)
    if p.returncode != 0:
        hint = ""
        if "permission denied" in (p.stderr or "").lower():
            hint = ("\n\nYour user can't talk to Docker. Fix it with:\n  sudo usermod -aG docker $USER\n"
                    "then log out and back in (or run: newgrp docker), and run this again.")
        sys.exit(f"Docker is installed but not reachable: {p.stderr.strip()[:300]}{hint}")
    say(f"\n{bold('SelfHostBench ' + VERSION)}  {dim('measures how self-hosted apps run on this machine')}")
    say(f"\n  {bold('This machine:')} {hw['device_label']} · {hw['cpu_threads']} threads · {hw['ram_gb']} GB RAM"
        + (f" · {', '.join(hw['gpus'])}" if hw["gpus"] else ""))
    if hw["virtualization"] != "none":
        note(f"Running inside {VIRT_NAMES.get(hw['virtualization'], 'a VM')}; results will be labelled as such.")
    say(f"\n  {bold('It will test:')}")
    w = max(len(PLAN[a]["name"]) for a in apps) + 3
    for i, a in enumerate(apps, 1):
        lo, hi = PLAN[a]["minutes"]
        say(f"    {i}. {PLAN[a]['name']:<{w}}~{PLAN[a]['download_mb'] / 1000:.1f} GB download   {lo}-{hi} min")
    total_gb = sum(PLAN[a]["download_mb"] for a in apps) / 1000
    lo, hi = sum(PLAN[a]["minutes"][0] for a in apps), sum(PLAN[a]["minutes"][1] for a in apps)
    say(f"       {'Total':<{w}}~{total_gb:.1f} GB download   {lo}-{hi} min")
    free_gb = shutil.disk_usage(Path.home()).free / 1e9
    need = total_gb * 2.5 + 3
    say(f"\n  Free disk: {free_gb:.0f} GB (needs about {need:.0f} GB while running).")
    say("  Everything it creates is removed afterwards. Nothing is sent unless you say yes at the end.")
    say(f"  {dim('Tip: for fair numbers, pause other heavy work (transcodes, backups, games) while it runs.')}")
    if free_gb < need:
        warn("Free disk space looks low (Docker may store images elsewhere, so this may be fine).")
    say("")
    if not ask("Start the benchmark?", default=True):
        sys.exit(0)


def main_run(args):
    global ASSUME_YES
    ASSUME_YES = args.yes
    apps = [a.strip() for a in args.apps.split(",") if a.strip()]
    bad = [a for a in apps if a not in TESTS]
    if bad:
        sys.exit(f"unknown app(s): {', '.join(bad)}. Choose from: {', '.join(TESTS)}")
    if not shutil.which("docker"):
        sys.exit("Docker is required but the `docker` command was not found. Install Docker, then run again.")
    hw = detect_hardware()
    preflight(apps, hw)
    images_before = set(docker("image", "ls", "-q", "--no-trunc", check=False).stdout.split())
    hw_public = {k: v for k, v in hw.items() if k != "nvidia"}
    doc = {"schema_version": SCHEMA_VERSION, "script_version": VERSION, "run_id": RUN_ID,
           "started_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%MZ"),
           "hardware": hw_public, "tests": [], "duration_s": 0}
    t_all = time.monotonic()
    try:
        for i, app in enumerate(apps, 1):
            heading(f"[{i}/{len(apps)}] {PLAN[app]['name']}")
            t0 = time.monotonic()
            try:
                results = TESTS[app](hw, not args.no_gpu)
            except Exception as e:  # keep going with the other apps
                warn(red(f"{app} test failed: {e}"))
                results = [{"app": app, "test": "all", "accel": "none", "image": IMAGES[app].split("@")[0],
                            "image_digest": IMAGES[app].split("@")[-1], "status": "failed",
                            "reason": str(e)[:300], "metrics": {}, "resources": {}}]
            for r in results:
                r["duration_s"] = round(time.monotonic() - t0)
                r.setdefault("reason", None)
            doc["tests"].extend(results)
            cleanup()
    finally:
        cleanup()
    doc["duration_s"] = round(time.monotonic() - t_all)
    results_dir = HOME / "results"
    results_dir.mkdir(parents=True, exist_ok=True)
    path = results_dir / f"{datetime.now().strftime('%Y%m%d-%H%M%S')}-{RUN_ID}.json"
    path.write_text(json.dumps(doc, indent=2))
    summary(doc)
    note(f"Finished in {fmt_secs(doc['duration_s'])}. Saved to {path}")
    if args.no_submit:
        note(f"Not submitted (--no-submit). To submit later: python3 {sys.argv[0]} submit {path}")
    else:
        offer_submit(doc, path, args.api)
    new_images = [i for i in docker("image", "ls", "-q", "--no-trunc", check=False).stdout.split()
                  if i not in images_before]
    sizes = sum(int(docker("image", "inspect", "--format", "{{.Size}}", i, check=False).stdout.strip() or 0)
                for i in new_images)
    if new_images or (HOME / "cache").exists():
        say("")
        if args.keep_images or ask(f"Keep the downloaded Docker images and test media (~{fmt_bytes(sizes)}) for next time?",
                                   default=False):
            note("Kept. Run again any time; nothing will need downloading.")
        else:
            with Status("Removing downloaded images and test media"):
                for i in set(new_images):
                    docker("rmi", "-f", i, check=False)
                shutil.rmtree(HOME / "cache", ignore_errors=True)
    say(f"\n{green(TICK)} All done. Containers and temporary data have been removed.\n")


