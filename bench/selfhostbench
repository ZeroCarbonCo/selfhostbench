# ---------------------------------------------------------------- submission

def submit(doc, api=API_BASE):
    body = json.dumps(doc).encode()
    headers = {"Content-Type": "application/json", "User-Agent": f"selfhostbench/{VERSION}"}
    if os.environ.get("SELFHOSTBENCH_OWNER_TOKEN"):  # maintainer's own test runs, excluded from counts
        headers["X-SHB-Owner"] = os.environ["SELFHOSTBENCH_OWNER_TOKEN"]
    for attempt in (1, 2):
        try:
            req = urllib.request.Request(f"{api}/api/submit", data=body, method="POST", headers=headers)
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            msg = e.read().decode(errors="replace")[:300]
            if e.code < 500:
                raise RuntimeError(f"server rejected the result ({e.code}): {msg}")
            err = f"{e.code} {msg}"
        except (urllib.error.URLError, OSError) as e:
            err = str(e)
        if attempt == 1:
            say(f"    submission failed ({err}); retrying in 5 s …")
            time.sleep(5)
    raise RuntimeError(err)


def offer_submit(doc, path, api, confirmed=False):
    say("\nThis is exactly what would be sent:\n")
    say(json.dumps(doc, indent=2))
    if not confirmed and not ask("\nSubmit these results?", default=False):
        say(f"Not submitted. To submit later: selfhostbench submit {path}")
        return
    try:
        r = submit(doc, api)
        say(f"Submitted. Your result: {r.get('url', r)}")
    except RuntimeError as e:
        say(f"Could not submit ({e}).\nYour results are saved in {path}\nTo try again later: selfhostbench submit {path}")


# ---------------------------------------------------------------- main

def preflight(apps):
    if not shutil.which("docker"):
        sys.exit("Docker is required but the `docker` command was not found. Install Docker, then run again.")
    p = docker("info", "--format", "{{.ServerVersion}}", check=False)
    if p.returncode != 0:
        hint = ""
        if "permission denied" in (p.stderr or "").lower():
            hint = ("\nYour user cannot reach the Docker socket. Either run `sudo usermod -aG docker $USER` "
                    "and log in again, or run this script with sudo.")
        sys.exit(f"Docker is installed but not reachable: {p.stderr.strip()[:300]}{hint}")
    free_gb = shutil.disk_usage(Path.home()).free / 1e9
    need = sum(PLAN[a]["download_mb"] for a in apps) / 1000 * 2.5 + 3
    step("SelfHostBench will test:")
    for a in apps:
        say(f"    - {PLAN[a]['name']}: ~{PLAN[a]['download_mb'] / 1000:.1f} GB download, ~{PLAN[a]['minutes']} min")
    say(f"    Free disk in your home directory: {free_gb:.0f} GB (needs roughly {need:.0f} GB while running)")
    say("    Everything it creates is removed afterwards. Nothing is sent unless you say yes at the end.")
    if free_gb < need:
        say("    WARNING: free disk space looks too low (Docker may store images elsewhere).")
    if not ask("Continue?", default=True):
        sys.exit(0)


def summary(doc):
    step("Results")
    labels = {"generate": "chat generation", "transcode_4k_1080p": "4K->1080p transcode",
              "concurrent_streams": "simultaneous 1080p streams", "clip_embeddings": "smart-search embeddings",
              "face_detection": "face detection"}
    for t in doc["tests"]:
        m = t["metrics"]
        if t["status"] != "ok":
            val = f"{t['status']}: {t.get('reason') or ''}"
        elif "tokens_per_s" in m:
            val = f"{m['tokens_per_s']} tokens/s"
        elif "fps" in m:
            val = f"{m['fps']} fps ({m['speed']}x)"
        elif "streams" in m:
            val = f"{m['streams']} stream(s) at >= 1x" + (" (cap)" if m["streams"] >= m["cap"] else "")
        else:
            val = f"{m['images_per_s']} images/s"
        say(f"    {t['app']:<9} {labels.get(t['test'], t['test']):<28} [{t['accel']}] {val}")


def main_run(args):
    global ASSUME_YES
    ASSUME_YES = args.yes
    apps = [a.strip() for a in args.apps.split(",") if a.strip()]
    bad = [a for a in apps if a not in TESTS]
    if bad:
        sys.exit(f"unknown app(s): {', '.join(bad)}. Choose from: {', '.join(TESTS)}")
    preflight(apps)
    images_before = set(docker("image", "ls", "-q", "--no-trunc", check=False).stdout.split())
    hw = detect_hardware()
    step(f"Detected: {hw['device_label']} · {hw['cpu_threads']} threads · {hw['ram_gb']} GB RAM"
         + (f" · GPU: {', '.join(hw['gpus'])}" if hw["gpus"] else ""))
    if hw["virtualization"] != "none":
        say(f"    Running under virtualisation ({hw['virtualization']}); results will be labelled as such.")
    hw_public = {k: v for k, v in hw.items() if k != "nvidia"}
    doc = {"schema_version": SCHEMA_VERSION, "script_version": VERSION, "run_id": RUN_ID,
           "started_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%MZ"),
           "hardware": hw_public, "tests": [], "duration_s": 0}
    t_all = time.monotonic()
    try:
        for app in apps:
            step(PLAN[app]["name"])
            t0 = time.monotonic()
            try:
                results = TESTS[app](hw, not args.no_gpu)
            except Exception as e:  # keep going with the other apps
                say(f"    FAILED: {e}")
                results = [{"app": app, "test": "all", "accel": "none", "image": IMAGES[app].split("@")[0],
                            "image_digest": IMAGES[app].split("@")[-1], "status": "failed",
                            "reason": str(e)[:300], "metrics": {}, "resources": {}}]
            for r in results:
                r["duration_s"] = round(time.monotonic() - t0)
                r.setdefault("reason", None)
            doc["tests"].extend(results)
            cleanup()
    finally:
        cleanup()
    doc["duration_s"] = round(time.monotonic() - t_all)
    results_dir = HOME / "results"
    results_dir.mkdir(parents=True, exist_ok=True)
    path = results_dir / f"{datetime.now().strftime('%Y%m%d-%H%M%S')}-{RUN_ID}.json"
    path.write_text(json.dumps(doc, indent=2))
    summary(doc)
    say(f"\nSaved to {path}")
    if args.no_submit:
        say(f"Not submitted (--no-submit). To submit later: selfhostbench submit {path}")
    else:
        offer_submit(doc, path, args.api)
    new_images = [i for i in docker("image", "ls", "-q", "--no-trunc", check=False).stdout.split()
                  if i not in images_before]
    if new_images or (HOME / "cache").exists():
        if args.keep_images or ask("Keep downloaded Docker images and test media for next time?", default=False):
            say("Kept.")
        else:
            for i in set(new_images):
                docker("rmi", "-f", i, check=False)
            shutil.rmtree(HOME / "cache", ignore_errors=True)
            say("Removed downloaded images and test media.")


def main_submit(args):
    global ASSUME_YES
    ASSUME_YES = args.yes
    path = Path(args.file)
    doc = json.loads(path.read_text())
    offer_submit(doc, path, args.api, confirmed=args.yes)


def main():
    p = argparse.ArgumentParser(prog="selfhostbench", description=__doc__)
    p.add_argument("--version", action="version", version=f"selfhostbench {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    for name in ("run", None):
        sp = sub.add_parser("run", help="run the benchmark (default)") if name else p
        sp.add_argument("--yes", "-y", action="store_true", help="skip prompts (does NOT auto-submit)")
        sp.add_argument("--apps", default=",".join(TESTS), help="comma-separated subset: ollama,jellyfin,immich")
        sp.add_argument("--no-submit", action="store_true", help="keep results local only")
        sp.add_argument("--no-gpu", action="store_true", help="do not try GPU acceleration")
        sp.add_argument("--keep-images", action="store_true", help="keep downloaded images and media afterwards")
        sp.add_argument("--api", default=API_BASE, help=argparse.SUPPRESS)
    sp = sub.add_parser("submit", help="submit a saved result file")
    sp.add_argument("file")
    sp.add_argument("--yes", "-y", action="store_true", help="submit without asking")
    sp.add_argument("--api", default=API_BASE, help=argparse.SUPPRESS)
    args = p.parse_args()
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(1))
    atexit.register(cleanup)
    try:
        main_submit(args) if args.cmd == "submit" else main_run(args)
    except KeyboardInterrupt:
        say("\nInterrupted; cleaning up …")
        cleanup()
        sys.exit(130)


if __name__ == "__main__":
    main()
