def test_ollama(hw, use_gpu):
    image = IMAGES["ollama"]
    ensure_image(image)
    vol = make_volume("ollama")
    args = ["-p", "127.0.0.1::11434", "-v", f"{vol}:/root/.ollama"]
    name, accel = None, "cpu"
    if use_gpu and hw["nvidia"]:
        try:
            name = start_container("ollama", image, ["--gpus", "all", *args])
            accel = "nvidia"
        except RuntimeError as e:
            say(f"    GPU not available to Docker ({str(e)[-120:]}); using CPU")
    if not name:
        name = start_container("ollama", image, args)
    base = f"http://127.0.0.1:{host_port(name, 11434)}"
    wait_http(f"{base}/api/version")
    say(f"    pulling model {OLLAMA_MODEL} (~2 GB) …")
    req = urllib.request.Request(f"{base}/api/pull", data=json.dumps({"model": OLLAMA_MODEL}).encode(),
                                 headers={"Content-Type": "application/json"})
    last = -10
    with urllib.request.urlopen(req, timeout=3600) as r:
        for line in r:
            d = json.loads(line)
            if "error" in d:
                raise RuntimeError(f"model pull failed: {d['error']}")
            if d.get("total") and d.get("completed"):
                pct = int(100 * d["completed"] / d["total"])
                if pct >= last + 10:
                    say(f"      {pct}%")
                    last = pct
    digest = next((m.get("digest", "") for m in http_json(f"{base}/api/tags")["models"]
                   if m.get("name") == OLLAMA_MODEL), "")
    gen = {"model": OLLAMA_MODEL, "prompt": OLLAMA_PROMPT, "stream": False, "options": OLLAMA_OPTIONS}
    say("    warm-up run (loads the model) …")
    http_json(f"{base}/api/generate", dict(gen, options=dict(OLLAMA_OPTIONS, num_predict=8)), timeout=1800)
    ps = http_json(f"{base}/api/ps").get("models", [{}])
    size, vram = (ps[0].get("size") or 0, ps[0].get("size_vram") or 0) if ps else (0, 0)
    offload = round(100 * vram / size) if size else 0
    if accel == "nvidia" and offload == 0:
        accel = "cpu"  # container had the GPU but the model ran on CPU
    tps, ptps = [], []
    with Sampler(name) as s:
        for i in range(OLLAMA_RUNS):
            r = http_json(f"{base}/api/generate", gen, timeout=1800)
            tps.append(r["eval_count"] / r["eval_duration"] * 1e9)
            if r.get("prompt_eval_duration"):
                ptps.append(r["prompt_eval_count"] / r["prompt_eval_duration"] * 1e9)
            say(f"    run {i + 1}/{OLLAMA_RUNS}: {tps[-1]:.1f} tokens/s")
    return [{
        "app": "ollama", "test": "generate", "accel": accel, "image": image.split("@")[0],
        "image_digest": image_digest(image), "status": "ok",
        "metrics": {"tokens_per_s": round(statistics.median(tps), 2),
                    "prompt_tokens_per_s": round(statistics.median(ptps), 1) if ptps else None,
                    "runs_tokens_per_s": [round(x, 2) for x in tps], "gpu_offload_pct": offload,
                    "model": OLLAMA_MODEL, "model_digest": digest[:71]},
        "resources": s.result,
    }]


# ---------------------------------------------------------------- test: Jellyfin

def ffmpeg_progress(output):
    """Parse the last block of `ffmpeg -progress pipe:1`; ffmpeg itself reports fps and speed."""
    block = {}
    for line in output.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            block[k.strip()] = v.strip()
    if block.get("progress") != "end":
        return None
    try:
        return {"frames": int(block["frame"]), "fps": float(block["fps"]),
                "speed": float(block["speed"].rstrip("x"))}
    except (KeyError, ValueError):
        return None


def transcode_cmd(name, method, seconds=None):
    cmd = ["docker", "exec", name, FFMPEG, "-hide_banner", "-nostats", "-loglevel", "error", "-progress", "pipe:1"]
    if method == "vaapi":
        cmd += ["-init_hw_device", "vaapi=va:/dev/dri/renderD128", "-hwaccel", "vaapi",
                "-hwaccel_output_format", "vaapi"]
    elif method == "nvenc":
        cmd += ["-hwaccel", "cuda", "-hwaccel_output_format", "cuda"]
    if seconds:
        cmd += ["-t", str(seconds)]
    cmd += ["-i", "/media/clip.mkv", "-an", "-sn"]
    if method == "vaapi":
        cmd += ["-vf", f"scale_vaapi=w={SCALE_W}:h={SCALE_H}:format=nv12", "-c:v", "h264_vaapi", "-b:v", "8M",
                "-maxrate", "8M"]
    elif method == "nvenc":
        cmd += ["-vf", f"scale_cuda={SCALE_W}:{SCALE_H}", "-c:v", "h264_nvenc", "-preset", "p4", "-b:v", "8M",
                "-maxrate", "8M"]
    else:
        cmd += ["-vf", f"scale={SCALE_W}:{SCALE_H}", *X264]
    return cmd + ["-f", "null", "-"]


def run_streams(name, method, n, seconds, timeout):
    procs = [subprocess.Popen(transcode_cmd(name, method, seconds), stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, text=True) for _ in range(n)]
    results = []
    deadline = time.monotonic() + timeout
    for p in procs:
        try:
            out, _ = p.communicate(timeout=max(1, deadline - time.monotonic()))
            results.append(ffmpeg_progress(out))
        except subprocess.TimeoutExpired:
            results.append(None)
    for p in procs:
        if p.poll() is None:
            p.kill()
    if any(r is None for r in results):
        # Too slow to finish in time, or a crash: kill leftover ffmpeg inside the container.
        docker("exec", name, "pkill", "-f", "jellyfin-ffmpeg", check=False)
        return None
    return results


def test_jellyfin(hw, use_gpu):
    image = IMAGES["jellyfin"]
    ensure_image(image)
    clip = fetch_media("clip")
    args = ["--entrypoint", "/bin/sleep", "-v", f"{clip}:/media/clip.mkv:ro"]
    hw_method = None
    if use_gpu and hw["dri_render_nodes"] and Path("/dev/dri/renderD128").exists():
        hw_method = "vaapi"
        args += ["--device", "/dev/dri:/dev/dri", "--group-add", str(os.stat("/dev/dri/renderD128").st_gid)]
    elif use_gpu and hw["nvidia"]:
        hw_method = "nvenc"
        args += ["--gpus", "all", "-e", "NVIDIA_DRIVER_CAPABILITIES=compute,video,utility"]
    try:
        name = start_container("jellyfin", image, args, ["infinity"])
    except RuntimeError:
        if not hw_method:
            raise
        say(f"    could not pass the GPU through ({hw_method}); software only")
        hw_method = None
        name = start_container("jellyfin", image, ["--entrypoint", "/bin/sleep", "-v", f"{clip}:/media/clip.mkv:ro"],
                               ["infinity"])
    digest = image_digest(image)
    out = []

    def record(test, accel, metrics, res, status="ok", reason=None):
        out.append({"app": "jellyfin", "test": test, "accel": accel, "image": image.split("@")[0],
                    "image_digest": digest, "status": status, "reason": reason, "metrics": metrics,
                    "resources": res})

    for method in ["software"] + ([hw_method] if hw_method else []):
        accel = "cpu" if method == "software" else method
        label = "software (CPU)" if method == "software" else f"hardware ({method})"
        say(f"    4K HEVC -> 1080p H.264, {label} …")
        # Short warm-up so one-off start-up costs (e.g. GPU driver JIT) don't count against the result.
        if not run_streams(name, method, 1, 2, timeout=900):
            record("transcode_4k_1080p", accel, {}, {}, "failed", f"{method} warm-up did not complete")
            say("      failed")
            continue
        with Sampler(name) as s:
            r = run_streams(name, method, 1, None, timeout=1800)
        if not r:
            record("transcode_4k_1080p", accel, {}, s.result, "failed",
                   f"{method} transcode did not complete")
            say(f"      failed")
            continue
        say(f"      {r[0]['fps']:.1f} fps ({r[0]['speed']:.2f}x real time)")
        record("transcode_4k_1080p", accel, {"fps": r[0]["fps"], "speed": r[0]["speed"]}, s.result)
        say(f"    simultaneous 4K -> 1080p streams at >= 1x real time, {label} …")
        best = 0
        with Sampler(name) as s:
            for n in range(1, CONCURRENCY_CAP + 1):
                res = run_streams(name, method, n, CONCURRENCY_SECONDS, timeout=CONCURRENCY_SECONDS * 6)
                slowest = min(x["speed"] for x in res) if res else 0
                say(f"      {n} stream(s): slowest {slowest:.2f}x")
                if slowest < 1.0:
                    break
                best = n
        record("concurrent_streams", accel, {"streams": best, "cap": CONCURRENCY_CAP}, s.result)
    return out


# ---------------------------------------------------------------- test: Immich ML

def multipart(fields, file_bytes):
    boundary = "shb" + uuid.uuid4().hex
    body = b""
    for k, v in fields.items():
        body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n").encode()
    body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"image\"; filename=\"image.jpg\"\r\n"
             "Content-Type: application/octet-stream\r\n\r\n").encode() + file_bytes + f"\r\n--{boundary}--\r\n".encode()
    return body, f"multipart/form-data; boundary={boundary}"


def immich_predict(base, entries, image_bytes, timeout=60):
    body, ctype = multipart({"entries": json.dumps(entries)}, image_bytes)
    req = urllib.request.Request(f"{base}/predict", data=body, headers={"Content-Type": ctype})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


